# Copiar para .env e preencher (nunca commitar o .env).
# No Vercel, as mesmas variaveis definem-se em Settings -> Environment Variables.

# Forma "chave=valor" (evita problemas com caracteres especiais na palavra-passe):
DATABASE_URL=host=HOST_DO_SERVIDOR dbname=NOME_DA_BASE user=UTILIZADOR password=PALAVRA-PASSE

# Texto longo e aleatorio, usado para assinar os tokens de login
JWT_SECRET=

# Opcional (por omissao Europe/Lisbon)
# FUSO_HORARIO=Europe/Lisbon
